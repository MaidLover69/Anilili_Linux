QMainWindow, QWidget#central_widget {
    background-color: #050506;
    color: #ffffff;
    font-family: "Inter", "Noto Sans", sans-serif;
    font-size: 14px;
}

#sidebar {
    background-color: #020203;
    border-right: 1px solid rgba(255,255,255,0.07);
}

QPushButton.nav_item {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 10px 12px;
    color: rgba(255,255,255,0.38);
    text-align: left;
    font-weight: 500;
}
QPushButton.nav_item:hover {
    background-color: #141416;
    color: rgba(255,255,255,0.85);
}
QPushButton.nav_item[active="true"] {
    background-color: rgba(137,121,242,0.12);
    color: #8979F2;
    border-left: 3px solid #8979F2;
}

.anime-card {
    background-color: #0e0e10;
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,0.07);
}
.anime-card:hover {
    border-color: rgba(137,121,242,0.5);
}

QPushButton.primary {
    background-color: #8979F2;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 600;
}
QPushButton.primary:hover {
    background-color: #9d91f5;
}
QPushButton.primary:pressed {
    background-color: #7060e0;
}

QPushButton.secondary {
    background-color: rgba(137,121,242,0.12);
    color: #a99ef5;
    border: 1px solid rgba(137,121,242,0.5);
    border-radius: 8px;
    padding: 8px 16px;
}
QPushButton.secondary:hover {
    background-color: rgba(137,121,242,0.22);
}

QPushButton.chip {
    background-color: rgba(137,121,242,0.12);
    color: #a99ef5;
    border: 1px solid rgba(137,121,242,0.3);
    border-radius: 999px;
    padding: 4px 12px;
    font-size: 12px;
}
QPushButton.chip[selected="true"] {
    background-color: #8979F2;
    color: #ffffff;
    border-color: #8979F2;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: rgba(255,255,255,0.15);
    border-radius: 4px;
    min-height: 40px;
}
QScrollBar::handle:vertical:hover {
    background: rgba(137,121,242,0.5);
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: rgba(255,255,255,0.15);
    border-radius: 3px;
}
QScrollBar::handle:horizontal:hover {
    background: rgba(137,121,242,0.5);
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollArea {
    background: transparent;
    border: none;
}
QScrollArea > QWidget {
    background: transparent;
    border: none;
}
QScrollArea > QWidget > QWidget {
    background: transparent;
    border: none;
}

QLineEdit {
    background-color: #1a1a1d;
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 8px;
    padding: 8px 12px;
    color: #ffffff;
    selection-background-color: rgba(137,121,242,0.4);
}
QLineEdit:focus {
    border-color: rgba(137,121,242,0.5);
}

QComboBox {
    background-color: #1a1a1d;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    padding: 6px 12px;
    color: #ffffff;
    font-size: 13px;
    font-weight: 500;
}
QComboBox:hover {
    border-color: #8979F2;
    background-color: #222226;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border: none;
}
QComboBox QAbstractItemView {
    background-color: #1a1a1d;
    color: #ffffff;
    selection-background-color: #8979F2;
    selection-color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    outline: 0px;
    padding: 4px;
}
QComboBox QAbstractItemView::viewport {
    background-color: #1a1a1d;
    border: none;
}
QComboBox QAbstractItemView::item {
    min-height: 28px;
    padding: 6px 10px;
    color: #ffffff;
    background-color: #1a1a1d;
    border-radius: 4px;
    border: none;
}
QComboBox QAbstractItemView::item:hover {
    background-color: rgba(137, 121, 242, 0.25);
    color: #ffffff;
}
QComboBox QAbstractItemView::item:selected {
    background-color: #8979F2;
    color: #ffffff;
}

QMenu {
    background-color: #1a1a1d;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    padding: 4px;
}
QMenu::item {
    padding: 6px 12px;
    border-radius: 4px;
    color: #ffffff;
}
QMenu::item:selected {
    background-color: #8979F2;
    color: #ffffff;
}


